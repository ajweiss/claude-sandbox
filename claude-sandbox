#!/usr/bin/env bash
# claude-sandbox — run Claude Code in a Docker container with
# permission prompts disabled. Optional NVIDIA GPU passthrough.
#
# Install:
#   cp claude-sandbox ~/.local/bin/
#   # Put Dockerfile.claude-sandbox next to it or at ~/.config/claude-sandbox/Dockerfile
#
# Usage:
#   claude-sandbox                    # run in current directory (bridge networking)
#   claude-sandbox --gpu              # with GPU passthrough
#   claude-sandbox --host-net         # use host networking (loopback exposed)
#   claude-sandbox --microvm          # use Kata as the Docker runtime (Linux)
#   claude-sandbox --usb=usrp         # pass through one matched USB device
#   claude-sandbox --usb-all          # pass through every USB device
#   claude-sandbox --resume           # resume last conversation
#   claude-sandbox --resume <id>      # resume specific conversation
#   claude-sandbox -p "do the thing"  # pass a prompt
#   claude-sandbox --help             # show wrapper-specific help
#   claude-sandbox -- --help          # forward --help to claude itself
#
# Networking: defaults to bridge. The container can reach host services via
# the hostname `host.docker.internal`. Use --host-net to share the host's
# network namespace (needed e.g. when something binds to ::1 / 127.0.0.1).
#
# Any unrecognized flags are forwarded to `claude`.

set -euo pipefail

# ---------- config ----------
IMAGE_NAME="claude-sandbox"
SHM_SIZE="${CLAUDE_SANDBOX_SHM:-24g}"
BASE_IMAGE="${CLAUDE_SANDBOX_BASE_IMAGE:-nvidia/cuda:12.6.3-runtime-ubuntu24.04}"

# ---------- usage ----------
usage() {
  cat <<EOF
claude-sandbox — run Claude Code in a Docker container with
permission prompts disabled.

Usage:
  claude-sandbox [WRAPPER FLAGS] [CLAUDE FLAGS]

Wrapper flags:
  --gpu              Pass NVIDIA GPUs through to the container.
  --host-net         Share the host's network namespace.
                     Default is bridge networking; reach host services
                     via host.docker.internal. Use this for tools that
                     bind to 127.0.0.1 / ::1 and can't be reconfigured.
  --microvm          Use Kata Containers as the Docker runtime, giving
                     a microVM (KVM) boundary instead of plain container
                     isolation. Linux only. Requires Kata installed and
                     registered with Docker. GPU + Kata also requires
                     IOMMU/VFIO on the host and a Kata guest image with
                     NVIDIA drivers; see the README.
  --usb=<pattern>    Pass through one USB device whose manufacturer or
                     product string contains <pattern> (case-insensitive
                     substring). Errors if 0 or >1 devices match.
                     Linux only.
  --usb-vid-pid=<vid>:<pid>
                     Pass through USB device(s) with the given
                     vendor:product ID (4-digit hex, e.g. 1050:0407).
                     Linux only.
  --usb-all          Pass through ALL connected USB devices. Broad —
                     read the security note in the README before using.
                     Linux only.
  -h, --help         Show this message and exit.
  --                 End of wrapper flags. Everything after is passed
                     verbatim to claude (e.g. \`claude-sandbox -- --help\`
                     to see Claude's own help).

Environment:
  CLAUDE_SANDBOX_SHM         --shm-size for docker (default: 24g)
  CLAUDE_SANDBOX_BASE_IMAGE  Base image for build
                             (default: nvidia/cuda:12.6.3-runtime-ubuntu24.04)
  CLAUDE_SANDBOX_RUNTIME     Docker runtime to pass via --runtime
                             (e.g. "kata", "runsc"). Lets you set a
                             default microvm/userspace-kernel runtime
                             without typing --microvm each time.
                             Empty = Docker's default (runc).

GPU support (--gpu):
  Requires the NVIDIA driver and the NVIDIA Container Toolkit on the
  host, registered with Docker. See the README for setup steps.

Any other flags are forwarded to \`claude\`. Examples:
  claude-sandbox --resume
  claude-sandbox --gpu -p "summarize this repo"
  claude-sandbox -- --help        # see Claude's own CLI flags
EOF
}

# ---------- parse our flags vs claude flags ----------
GPU_MODE=false
HOST_NET=false
MICROVM=false
USB_ALL=false
USB_PATTERN=""
USB_VID_PID=""
CLAUDE_ARGS=()

while [ $# -gt 0 ]; do
  case "$1" in
    --gpu)              GPU_MODE=true ;;
    --host-net)         HOST_NET=true ;;
    --microvm)          MICROVM=true ;;
    --usb-all)          USB_ALL=true ;;
    --usb=*)            USB_PATTERN="${1#--usb=}" ;;
    --usb-vid-pid=*)    USB_VID_PID="${1#--usb-vid-pid=}" ;;
    -h|--help)          usage; exit 0 ;;
    --)                 shift; CLAUDE_ARGS+=("$@"); break ;;
    *)                  CLAUDE_ARGS+=("$1") ;;
  esac
  shift
done

# ---------- USB device resolution ----------
# Match against `lsusb` output. lsusb is part of usbutils — present on
# most Linux hosts; we error cleanly if it isn't.
#   pattern: case-insensitive substring of the whole lsusb line; errors
#            on 0 or >1 matches.
#   vidpid:  exact "vid:pid" (matched as the ID field of the lsusb line).
resolve_usb() {
  local flag="$1" mode="$2" val="$3"
  if ! command -v lsusb >/dev/null 2>&1; then
    echo "Error: $flag requires lsusb (install usbutils)." >&2
    exit 1
  fi
  local lines
  case "$mode" in
    pattern) lines="$(lsusb | grep -iF -- "$val" || true)" ;;
    vidpid)  lines="$(lsusb | grep -F -- " ID $val " || true)" ;;
  esac
  if [ -z "$lines" ]; then
    echo "Error: $flag matched no connected USB devices. Plugged in:" >&2
    lsusb | sed 's/^/  /' >&2
    exit 1
  fi
  if [ "$mode" = "pattern" ] && [ "$(echo "$lines" | wc -l)" -gt 1 ]; then
    echo "Error: $flag matched multiple devices; refine the pattern:" >&2
    echo "$lines" | sed 's/^/  /' >&2
    exit 1
  fi
  local bus dev
  while IFS= read -r line; do
    bus="$(echo "$line" | sed -nE 's/^Bus 0*([0-9]+) Device.*/\1/p')"
    dev="$(echo "$line" | sed -nE 's/^Bus [0-9]+ Device 0*([0-9]+):.*/\1/p')"
    DOCKER_USB_ARGS+=(--device="$(printf '/dev/bus/usb/%03d/%03d' "$bus" "$dev")")
  done <<<"$lines"
}

# ---------- locate Dockerfile ----------
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
DOCKERFILE=""
for candidate in \
  "$SCRIPT_DIR/Dockerfile.claude-sandbox" \
  "${XDG_CONFIG_HOME:-$HOME/.config}/claude-sandbox/Dockerfile" \
  "$HOME/.claude/sandbox/Dockerfile"; do
  if [ -f "$candidate" ]; then
    DOCKERFILE="$candidate"
    break
  fi
done

if [ -z "$DOCKERFILE" ]; then
  echo "Error: No Dockerfile found. Place Dockerfile.claude-sandbox next to this script"
  echo "       or at ~/.config/claude-sandbox/Dockerfile"
  exit 1
fi

# ---------- build image if needed ----------
DOCKERFILE_HASH=$(sha256sum "$DOCKERFILE" | cut -c1-12)
TAGGED_IMAGE="$IMAGE_NAME:$DOCKERFILE_HASH"

if ! docker image inspect "$TAGGED_IMAGE" &>/dev/null; then
  echo "Building sandbox image..."
  docker build -t "$TAGGED_IMAGE" \
    --build-arg "BASE_IMAGE=$BASE_IMAGE" \
    -f "$DOCKERFILE" "$(dirname "$DOCKERFILE")"
  # Also tag as latest for convenience
  docker tag "$TAGGED_IMAGE" "$IMAGE_NAME:latest"
fi

# ---------- docker flags ----------
DOCKER_GPU_ARGS=()
if $GPU_MODE; then
  DOCKER_GPU_ARGS+=(--gpus all)
fi

DOCKER_NET_ARGS=()
if $HOST_NET; then
  DOCKER_NET_ARGS+=(--network host)
else
  # Default bridge networking. Expose host services by hostname rather than
  # by sharing the host's loopback interface.
  DOCKER_NET_ARGS+=(--add-host host.docker.internal:host-gateway)
fi

DOCKER_SECURITY_ARGS=(
  --security-opt=no-new-privileges
  --cap-drop=ALL
)

# Runtime: --microvm forces kata. Otherwise use CLAUDE_SANDBOX_RUNTIME if
# set. Otherwise leave empty so Docker uses its configured default (runc).
DOCKER_RUNTIME_ARGS=()
if $MICROVM; then
  DOCKER_RUNTIME_ARGS+=(--runtime=kata)
elif [ -n "${CLAUDE_SANDBOX_RUNTIME:-}" ]; then
  DOCKER_RUNTIME_ARGS+=(--runtime="$CLAUDE_SANDBOX_RUNTIME")
fi

# USB passthrough.
DOCKER_USB_ARGS=()
$USB_ALL && DOCKER_USB_ARGS+=(--device=/dev/bus/usb)
[ -n "$USB_PATTERN" ] && resolve_usb "--usb=$USB_PATTERN" pattern "$USB_PATTERN"
[ -n "$USB_VID_PID" ] && resolve_usb "--usb-vid-pid=$USB_VID_PID" vidpid "$USB_VID_PID"

# Pre-create host-side mount targets so every bind mount applies from
# the very first sandbox run on a fresh host. Without these, Docker
# would auto-create the source paths as empty dirs (wrong type for file
# mounts), and the RO overlays would silently no-op until something
# wrote to the parent RW mount. `touch` is idempotent and avoids the
# TOCTOU race that a check-then-write would have if host Claude is
# initializing the same files concurrently.
mkdir -p "$HOME/.claude" \
         "$HOME/.claude/agents" \
         "$HOME/.claude/commands" \
         "$HOME/.claude/hooks" \
         "$HOME/.claude/plugins"
touch    "$HOME/.claude/settings.json" \
         "$HOME/.claude/settings.local.json" \
         "$HOME/.claude.json"
chmod 600 "$HOME/.claude.json"

# Mount ~/.claude read-write for credentials, memory, transcripts, etc.,
# but layer specific subpaths read-only on top to block hook/plugin
# poisoning attacks against future host or sandbox runs.
DOCKER_RO_OVERLAYS=()
for entry in settings.json settings.local.json agents commands hooks plugins; do
  DOCKER_RO_OVERLAYS+=(-v "$HOME/.claude/$entry:/home/ubuntu/.claude/$entry:ro")
done

# ~/.claude.json (account, subscription, oauth identity, project list,
# onboarding state) is a sibling of ~/.claude/, not inside it. Without
# it Claude can't tell which account the credentials file belongs to
# and re-runs the OAuth flow on every startup. Mount it RW.
EXTRA_MOUNTS=(-v "$HOME/.claude.json:/home/ubuntu/.claude.json")

# ---------- workspace path ----------
# Use the real host path inside the container so Claude's project memory
# is keyed per-project, not a shared /workspace bucket.
HOST_DIR="$(pwd)"
CONTAINER_DIR="$HOST_DIR"

# ---------- run ----------
exec docker run --rm -it \
  -v "$HOST_DIR":"$CONTAINER_DIR" \
  -v "$HOME/.claude":/home/ubuntu/.claude \
  "${DOCKER_RO_OVERLAYS[@]}" \
  "${EXTRA_MOUNTS[@]}" \
  -v /etc/localtime:/etc/localtime:ro \
  -w "$CONTAINER_DIR" \
  --shm-size="$SHM_SIZE" \
  "${DOCKER_NET_ARGS[@]}" \
  "${DOCKER_SECURITY_ARGS[@]}" \
  "${DOCKER_GPU_ARGS[@]}" \
  "${DOCKER_RUNTIME_ARGS[@]}" \
  "${DOCKER_USB_ARGS[@]}" \
  "$TAGGED_IMAGE" \
  --dangerously-skip-permissions \
  "${CLAUDE_ARGS[@]}"
