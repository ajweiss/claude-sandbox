ARG BASE_IMAGE=nvidia/cuda:12.6.3-runtime-ubuntu24.04
FROM ${BASE_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates \
    python3 python3-pip python3-venv \
    libgl1 libglib2.0-0 \
    libcudnn9-cuda-12 \
    openssh-client rsync jq \
    && rm -rf /var/lib/apt/lists/*

# Node 20 (for projects that need it)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# just command runner
RUN curl -fsSL https://just.systems/install.sh | bash -s -- --to /usr/local/bin

# Match host user so file ownership isn't root. Ubuntu 24.04 base images
# already ship an `ubuntu` user at 1000:1000, so remap it when it exists
# instead of relying on useradd (which would fail and leave the UID wrong
# for hosts where the invoking user isn't 1000).
ARG UID=1000
ARG GID=1000
RUN if getent passwd ubuntu >/dev/null; then \
        groupmod -g "$GID" ubuntu \
        && usermod -u "$UID" -g "$GID" ubuntu; \
    else \
        groupadd -g "$GID" ubuntu \
        && useradd -m -u "$UID" -g "$GID" -s /bin/bash ubuntu; \
    fi \
    && chown -R "$UID:$GID" /home/ubuntu

USER ubuntu
RUN curl -LsSf https://astral.sh/uv/install.sh | bash
RUN curl -fsSL https://claude.ai/install.sh | bash

ENV PATH="/home/ubuntu/.local/bin:${PATH}"
ENTRYPOINT ["claude"]
